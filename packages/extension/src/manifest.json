{
  "manifest_version": 3,
  "name": "TrueScore",
  "version": "1.106.1",
  "description": "Cut through inflated ratings. See what's actually good on the shopping, travel, film and book sites you already use.",
  "author": "Mohamed Oun",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "unlimitedStorage", "alarms", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://truescore.mohamed3on.com/*",
    "https://caching.graphql.imdb.com/*",
    "*://*.google.com/maps/*",
    "https://apps.bazaarvoice.com/*",
    "*://www.saturn.de/*"
  ],
  "declarative_net_request": {
    "rule_resources": [{ "id": "saturn-bv", "enabled": true, "path": "saturn-bv-rules.json" }]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.airbnb.com/s/*/homes*",
        "*://www.airbnb.co.uk/s/*/homes*",
        "*://www.airbnb.ie/s/*/homes*",
        "*://www.airbnb.de/s/*/homes*",
        "*://www.airbnb.at/s/*/homes*",
        "*://www.airbnb.ch/s/*/homes*",
        "*://www.airbnb.fr/s/*/homes*",
        "*://www.airbnb.be/s/*/homes*",
        "*://www.airbnb.nl/s/*/homes*",
        "*://www.airbnb.es/s/*/homes*",
        "*://www.airbnb.it/s/*/homes*",
        "*://www.airbnb.pt/s/*/homes*",
        "*://www.airbnb.ca/s/*/homes*",
        "*://www.airbnb.com.au/s/*/homes*"
      ],
      "js": ["sites/airbnb-search.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.airbnb.com/rooms/*",
        "*://www.airbnb.co.uk/rooms/*",
        "*://www.airbnb.ie/rooms/*",
        "*://www.airbnb.de/rooms/*",
        "*://www.airbnb.at/rooms/*",
        "*://www.airbnb.ch/rooms/*",
        "*://www.airbnb.fr/rooms/*",
        "*://www.airbnb.be/rooms/*",
        "*://www.airbnb.nl/rooms/*",
        "*://www.airbnb.es/rooms/*",
        "*://www.airbnb.it/rooms/*",
        "*://www.airbnb.pt/rooms/*",
        "*://www.airbnb.ca/rooms/*",
        "*://www.airbnb.com.au/rooms/*"
      ],
      "js": ["sites/airbnb.js"],
      "css": ["sites/amazon-product.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.amazon.fr/*", "*://*.amazon.com/*", "*://*.amazon.co.uk/*",
        "*://*.amazon.com.mx/*", "*://*.amazon.co.jp/*", "*://*.amazon.it/*",
        "*://*.amazon.in/*", "*://*.amazon.eg/*", "*://*.amazon.es/*",
        "*://*.amazon.cn/*", "*://*.amazon.ca/*", "*://*.amazon.com.br/*",
        "*://*.amazon.de/*", "*://*.amazon.com.au/*"
      ],
      "js": ["sites/amazon-search.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.amazon.fr/*", "*://*.amazon.com/*", "*://*.amazon.co.uk/*",
        "*://*.amazon.com.mx/*", "*://*.amazon.co.jp/*", "*://*.amazon.it/*",
        "*://*.amazon.in/*", "*://*.amazon.eg/*", "*://*.amazon.es/*",
        "*://*.amazon.cn/*", "*://*.amazon.ca/*", "*://*.amazon.com.br/*",
        "*://*.amazon.de/*", "*://*.amazon.com.au/*"
      ],
      "js": ["sites/amazon-product.js"],
      "css": ["sites/amazon-product.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.booking.com/*"],
      "js": ["sites/booking-search.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.booking.com/hotel/*"],
      "js": ["sites/booking-hotel.js"],
      "css": ["sites/amazon-product.css", "sites/booking-hotel.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.decathlon.de/*", "*://*.decathlon.co.uk/*", "*://*.decathlon.es/*",
        "*://*.decathlon.fr/*", "*://*.decathlon.it/*", "*://*.decathlon.nl/*",
        "*://*.decathlon.be/*", "*://*.decathlon.pl/*", "*://*.decathlon.pt/*",
        "*://*.decathlon.at/*", "*://*.decathlon.ch/*", "*://*.decathlon.se/*",
        "*://*.decathlon.cz/*", "*://*.decathlon.ro/*", "*://*.decathlon.hu/*",
        "*://*.decathlon.gr/*", "*://*.decathlon.dk/*", "*://*.decathlon.ie/*",
        "*://*.decathlon.fi/*", "*://*.decathlon.sk/*", "*://*.decathlon.bg/*",
        "*://*.decathlon.hr/*", "*://*.decathlon.si/*", "*://*.decathlon.com/*",
        "*://*.decathlon.co.th/*", "*://*.decathlon.sg/*", "*://*.decathlon.my/*",
        "*://*.decathlon.ph/*", "*://*.decathlon.co.id/*", "*://*.decathlon.vn/*",
        "*://*.decathlon.com.hk/*", "*://*.decathlon.tw/*", "*://*.decathlon.co.kr/*",
        "*://*.decathlon.co.jp/*", "*://*.decathlon.com.au/*", "*://*.decathlon.com.kh/*", "*://*.decathlon.mt/*"
      ],
      "js": ["sites/decathlon-pdp.js"],
      "css": ["sites/amazon-product.css"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://*.decathlon.de/*", "*://*.decathlon.co.uk/*", "*://*.decathlon.es/*",
        "*://*.decathlon.fr/*", "*://*.decathlon.it/*", "*://*.decathlon.nl/*",
        "*://*.decathlon.be/*", "*://*.decathlon.pl/*", "*://*.decathlon.pt/*",
        "*://*.decathlon.at/*", "*://*.decathlon.ch/*", "*://*.decathlon.se/*",
        "*://*.decathlon.cz/*", "*://*.decathlon.ro/*", "*://*.decathlon.hu/*",
        "*://*.decathlon.gr/*", "*://*.decathlon.dk/*", "*://*.decathlon.ie/*",
        "*://*.decathlon.fi/*", "*://*.decathlon.sk/*", "*://*.decathlon.bg/*",
        "*://*.decathlon.hr/*", "*://*.decathlon.si/*", "*://*.decathlon.com/*",
        "*://*.decathlon.co.th/*", "*://*.decathlon.sg/*", "*://*.decathlon.my/*",
        "*://*.decathlon.ph/*", "*://*.decathlon.co.id/*", "*://*.decathlon.vn/*",
        "*://*.decathlon.com.hk/*", "*://*.decathlon.tw/*", "*://*.decathlon.co.kr/*",
        "*://*.decathlon.co.jp/*", "*://*.decathlon.com.au/*", "*://*.decathlon.com.kh/*"
      ],
      "js": ["sites/decathlon-plp.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.uniqlo.com/*"],
      "js": ["sites/uniqlo-pdp.js"],
      "css": ["sites/amazon-product.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.uniqlo.com/*"],
      "js": ["sites/uniqlo-plp.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.ikea.com/*/p/*"],
      "js": ["sites/ikea-pdp.js"],
      "css": ["sites/amazon-product.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.ikea.com/*"],
      "js": ["sites/ikea-plp.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.dm.de/*"],
      "js": ["sites/dm-pdp.js"],
      "css": ["sites/amazon-product.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.dm.de/*"],
      "js": ["sites/dm-plp.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.docmorris.de/*"],
      "js": ["sites/docmorris-pdp.js"],
      "css": ["sites/amazon-product.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.docmorris.de/*"],
      "js": ["sites/docmorris-plp.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.rossmann.de/*"],
      "js": ["sites/rossmann-pdp.js"],
      "css": ["sites/amazon-product.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.rossmann.de/*"],
      "js": ["sites/rossmann-plp.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://www.otto.de/*"],
      "js": ["sites/otto-pdp.js"],
      "css": ["sites/amazon-product.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://www.otto.de/*"],
      "js": ["sites/otto-plp.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://www.printful.com/*"],
      "js": ["sites/printful-pdp.js"],
      "css": ["sites/amazon-product.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.printful.com/*"],
      "js": ["sites/printful-plp.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.mediamarkt.de/*", "*://www.saturn.de/*"],
      "js": ["sites/mediamarkt-pdp.js"],
      "css": ["sites/amazon-product.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://www.mediamarkt.de/*", "*://www.saturn.de/*"],
      "js": ["sites/mediamarkt-plp.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.etsy.com/*"],
      "js": ["sites/etsy.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.etsy.com/listing/*", "*://*.etsy.com/*/listing/*"],
      "js": ["sites/etsy-pdp.js"],
      "css": ["sites/amazon-product.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.aliexpress.com/*", "*://*.aliexpress.us/*"],
      "js": ["sites/aliexpress.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.aliexpress.com/item/*", "*://*.aliexpress.us/item/*"],
      "js": ["sites/aliexpress-pdp.js"],
      "css": ["sites/amazon-product.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://bjjfanatics.com/products/*", "*://bjjfanatics.com/*/products/*"],
      "js": ["sites/bjjfanatics-pdp.js"],
      "css": ["sites/amazon-product.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://progressjj.co.uk/products/*", "*://progressjj.co.uk/*/products/*"],
      "js": ["sites/progress-pdp.js"],
      "css": ["sites/amazon-product.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://progressjj.co.uk/*"],
      "js": ["sites/progress-plp.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://wearthepeace.com/products/*", "*://wearthepeace.com/*/products/*"],
      "js": ["sites/helpfulcrowd-pdp.js"],
      "css": ["sites/amazon-product.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://wearthepeace.com/*"],
      "js": ["sites/helpfulcrowd-plp.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://bjjfanatics.com/search*", "*://bjjfanatics.com/collections/*"],
      "js": ["sites/bjjfanatics-plp.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.goodreads.com/book/show/*", "*://*.goodreads.com/*/book/show/*"],
      "js": ["sites/goodreads.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.google.com/maps/*", "*://*.google.com/maps*"],
      "js": ["sites/gmaps-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.google.com/maps/*", "*://*.google.com/maps*"],
      "js": ["sites/gmaps-capture.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.google.com/maps/*", "*://*.google.com/maps*"],
      "js": ["sites/gmaps.js", "sites/gmaps-search.js"],
      "css": ["sites/gmaps.css"],
      "world": "MAIN",
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.imdb.com/title/*/*"],
      "js": ["sites/imdb.js"],
      "css": ["sites/imdb.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.letterboxd.com/film/*/"],
      "js": ["sites/letterboxd.js"],
      "css": ["sites/letterboxd.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://www.transfermarkt.com/*", "*://www.transfermarkt.de/*"],
      "js": ["sites/transfermarkt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.reddit.com/*", "*://old.reddit.com/*"],
      "js": ["sites/reddit.js"],
      "css": ["sites/reddit.css"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://www.vinted.at/*", "*://www.vinted.be/*", "*://www.vinted.co.uk/*", "*://www.vinted.com/*", "*://www.vinted.cz/*",
        "*://www.vinted.de/*", "*://www.vinted.dk/*", "*://www.vinted.ee/*", "*://www.vinted.es/*", "*://www.vinted.fi/*",
        "*://www.vinted.fr/*", "*://www.vinted.gr/*", "*://www.vinted.hr/*", "*://www.vinted.hu/*", "*://www.vinted.ie/*",
        "*://www.vinted.it/*", "*://www.vinted.lt/*", "*://www.vinted.lu/*", "*://www.vinted.lv/*", "*://www.vinted.nl/*",
        "*://www.vinted.pl/*", "*://www.vinted.pt/*", "*://www.vinted.ro/*", "*://www.vinted.se/*", "*://www.vinted.si/*",
        "*://www.vinted.sk/*"
      ],
      "js": ["sites/vinted.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
